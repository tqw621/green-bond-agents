      <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeWidth=1.4;strokeColor=#526D87;fontColor=#526D87;fontFamily=Microsoft YaHei;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="inputs" target="preset" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeWidth=1.4;strokeColor=#526D87;fontColor=#526D87;fontFamily=Microsoft YaHei;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="preset" target="engine" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeWidth=1.4;strokeColor=#526D87;fontColor=#526D87;fontFamily=Microsoft YaHei;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="rules" target="engine" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeWidth=1.4;strokeColor=#526D87;fontColor=#526D87;fontFamily=Microsoft YaHei;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="engine" target="llm" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e7" value="页面批量实验" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeWidth=1.4;strokeColor=#526D87;fontColor=#526D87;fontFamily=Microsoft YaHei;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" source="engine" target="db" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
