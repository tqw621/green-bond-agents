      <mxCell id="e9" value="通过／有条件通过" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeWidth=1.4;strokeColor=#526D87;fontColor=#526D87;fontFamily=Microsoft YaHei;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="reg" target="uw" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
