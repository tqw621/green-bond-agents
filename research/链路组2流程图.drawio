      <mxCell id="e2" value="拒绝" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeWidth=1.4;strokeColor=#A85549;fontColor=#A85549;fontFamily=Microsoft YaHei;fontSize=13;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="cert" target="certStop" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
