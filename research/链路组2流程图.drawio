      <mxCell id="regStop" value="监管审核拒绝" style="rounded=1;arcSize=14;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#652E27;fillColor=#FCEFED;strokeColor=#BF776B;strokeWidth=1.3;spacing=8;" vertex="1" parent="1"><mxGeometry x="700" y="402" width="350" height="54" as="geometry"/></mxCell>
      <mxCell id="e3" value="拒绝" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeWidth=1.4;strokeColor=#A85549;fontColor=#A85549;fontFamily=Microsoft YaHei;fontSize=13;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="reg" target="regStop" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="uw" value="4  承销定价与路演&#10;判断是否承销并形成票息和路演信息" style="rounded=1;arcSize=14;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#172D49;fillColor=#EAF2FD;strokeColor=#5D85BE;strokeWidth=1.3;spacing=8;" vertex="1" parent="1"><mxGeometry x="84" y="488" width="390" height="54" as="geometry"/></mxCell>
