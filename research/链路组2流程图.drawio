      <mxCell id="title" value="一家企业如何走完绿色债券发行模拟" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Microsoft YaHei;fontSize=31;fontColor=#162C46;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="26" width="1020" height="46" as="geometry"/></mxCell>
      <mxCell id="subtitle" value="链路组 2 接收第一组愿意发行的企业，记录首个失败环节。" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#385470;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="61" y="75" width="1020" height="32" as="geometry"/></mxCell>
