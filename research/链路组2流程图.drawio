<diagram id="software" name="Python 软件流程"><mxGraphModel dx="1100" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1140" pageHeight="820" math="0" shadow="0"><root>
      <mxCell id="0"/>
      <mxCell id="1" parent="0"/>
      <mxCell id="title" value="Python 如何运行实验并生成结果" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Microsoft YaHei;fontSize=31;fontColor=#162C46;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="26" width="1020" height="46" as="geometry"/></mxCell>
      <mxCell id="subtitle" value="正式实验以同一企业池运行 P0–P6，逐企业保留场景结果。" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#385470;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="61" y="75" width="1020" height="32" as="geometry"/></mxCell>
      <mxCell id="web" value="Streamlit 页面&#10;run.py 启动 app.py" style="rounded=1;arcSize=14;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#172D49;fillColor=#EAF2FD;strokeColor=#5D85BE;strokeWidth=1.3;spacing=8;" vertex="1" parent="1"><mxGeometry x="75" y="132" width="390" height="62" as="geometry"/></mxCell>
      <mxCell id="cli" value="命令行&#10;run.py --preset" style="rounded=1;arcSize=14;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#172D49;fillColor=#EAF2FD;strokeColor=#5D85BE;strokeWidth=1.3;spacing=8;" vertex="1" parent="1"><mxGeometry x="675" y="132" width="390" height="62" as="geometry"/></mxCell>
      <mxCell id="inputs" value="导入企业池 · engine.py&#10;校验 CSV／XLSX，保留原始企业编号" style="rounded=1;arcSize=14;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#263B50;fillColor=#F2F5F8;strokeColor=#8B9BAB;strokeWidth=1.3;spacing=8;" vertex="1" parent="1"><mxGeometry x="360" y="227" width="420" height="61" as="geometry"/></mxCell>
      <mxCell id="preset" value="P0–P6 场景编排 · scenarios.py&#10;同一企业池逐家运行，按企业和环节配对规则随机数" style="rounded=1;arcSize=14;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#172D49;fillColor=#EAF2FD;strokeColor=#5D85BE;strokeWidth=1.3;spacing=8;" vertex="1" parent="1"><mxGeometry x="340" y="322" width="460" height="61" as="geometry"/></mxCell>
      <mxCell id="engine" value="五关编排 · engine.py&#10;先检查材料，按顺序判断，记录终态及首个失败原因" style="rounded=1;arcSize=14;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#172D49;fillColor=#EAF2FD;strokeColor=#5D85BE;strokeWidth=1.3;spacing=8;" vertex="1" parent="1"><mxGeometry x="340" y="418" width="460" height="66" as="geometry"/></mxCell>
      <mxCell id="rules" value="规则计算 · rules.py&#10;纯规则与 LLM 降级使用" style="rounded=1;arcSize=14;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#563F18;fillColor=#FFF5DC;strokeColor=#BE9950;strokeWidth=1.3;spacing=8;" vertex="1" parent="1"><mxGeometry x="65" y="425" width="240" height="53" as="geometry"/></mxCell>
      <mxCell id="llm" value="模型判断 · agents.py&#10;调用接口、解析 JSON、传递摘要" style="rounded=1;arcSize=14;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#563F18;fillColor=#FFF5DC;strokeColor=#BE9950;strokeWidth=1.3;spacing=8;" vertex="1" parent="1"><mxGeometry x="835" y="425" width="245" height="53" as="geometry"/></mxCell>
      <mxCell id="db" value="Web 批量结果 · database.py&#10;SQLite 按实验批次和场景落库" style="rounded=1;arcSize=14;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#172D49;fillColor=#EAF2FD;strokeColor=#5D85BE;strokeWidth=1.3;spacing=8;" vertex="1" parent="1"><mxGeometry x="75" y="550" width="390" height="61" as="geometry"/></mxCell>
      <mxCell id="json" value="命令行结果 · run.py&#10;逐企业 JSON 和场景汇总" style="rounded=1;arcSize=14;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#172D49;fillColor=#EAF2FD;strokeColor=#5D85BE;strokeWidth=1.3;spacing=8;" vertex="1" parent="1"><mxGeometry x="675" y="550" width="390" height="61" as="geometry"/></mxCell>
      <mxCell id="ui" value="统计与文本分析 · app.py&#10;历史统计、jieba 文本分析及静态图表导出" style="rounded=1;arcSize=14;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#173C2A;fillColor=#E8F5EE;strokeColor=#5D9A78;strokeWidth=1.3;spacing=8;" vertex="1" parent="1"><mxGeometry x="75" y="663" width="390" height="65" as="geometry"/></mxCell>
      <mxCell id="join" value="研究分析&#10;同企业对照 P0，与第一组意愿结果合并" style="rounded=1;arcSize=14;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#173C2A;fillColor=#E8F5EE;strokeColor=#5D9A78;strokeWidth=1.3;spacing=8;" vertex="1" parent="1"><mxGeometry x="675" y="663" width="390" height="65" as="geometry"/></mxCell>
